# Copy to supabase/functions/.env (ignored by Git) and fill in real values.
# Hosted projects: set the same names with `supabase secrets set`.

# Random secret used to hash client IP addresses before storing them.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMBERSHIP_IP_HASH_SALT=

# Exact browser origins allowed to call this API (comma-separated, no
# trailing slash). Local: the address your frontend dev server uses.
# Hosted: the GitHub Pages origin, e.g. https://<account>.github.io
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
