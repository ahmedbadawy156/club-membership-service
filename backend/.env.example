# Copy to backend/.env (ignored by Git) to run the API on your PC with
# npm run dev against the tables and secret in Floci. Nothing here is secret:
# Floci uses fake test keys from the "floci" AWS profile.
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:4566

AWS_PROFILE=floci
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

SECRET_ID=club-membership/secrets
USERS_TABLE=ClubUsers
REQUESTS_TABLE=MembershipRequests
AUDIT_TABLE=AuditLog
RATE_LIMITS_TABLE=RateLimits
